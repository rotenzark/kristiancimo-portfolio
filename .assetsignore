# Files Cloudflare Workers Assets should NOT bundle/deploy.
# Same syntax as .gitignore.

# Git internals — huge pack files, not needed at runtime
.git/
.github/
.gitignore
.gitattributes

# Documentation & config not served to users
README.md
wrangler.toml
wrangler.jsonc

# Build script — generates project/<slug>/ and sitemap.xml, never served
tools/

# Editor / OS junk
.DS_Store
.vscode/
.idea/

# Local tooling state and secrets — never public.
# .wrangler/ is wrangler's own cache (wrangler-account.json with the account id,
# cf.json with the geo data of the connection) plus temp build files. Without this
# line `wrangler deploy` uploads them and the domain serves them: it happened on
# 2026-09-15.
.wrangler/
.dev.vars*
.env*
node_modules/
*.log
.assetsignore
