{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kristiancimo-portfolio",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Unknown paths get 404.html with a real 404 status (it was an empty body).
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
